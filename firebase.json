{
  "database": { "rules": "firebase/database.rules.json" },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "emulators": { "database": { "port": 19000 }, "ui": { "enabled": false } }
}
